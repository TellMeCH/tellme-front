{
  "name": "@tellme/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "lint": "npx tsc && npx eslint ./",
    "format": "npx prettier --write . && npm run lint -- --fix",
    "prepare": "husky",
    "deps:sync": "npx syncpack fix-mismatches",
    "postinstall": "patch-package",
    "test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" nx run-many -t test --projects=tag:test --skipNxCache",
    "build:web": "npx nx build web --skip-nx-cache",
    "start:web": "npx nx start web --skip-nx-cache",
    "dev:web": "npx nx dev web --skip-nx-cache",
    "build:landing": "npx nx build landing --skip-nx-cache",
    "start:landing": "npx nx start landing --skip-nx-cache",
    "dev:landing": "npx nx dev landing --skip-nx-cache"
  },
  "private": true,
  "dependencies": {
    "@heroui/react": "~2.6.14",
    "@hookform/resolvers": "^5.2.2",
    "@react-hooks-library/core": "^0.6.2",
    "@ronas-it/axios-api-client": "^0.2.0",
    "@ronas-it/rtkq-entity-api": "1.0.0",
    "autoprefixer": "^10.4.23",
    "class-transformer": "^0.5.1",
    "clsx": "^2.1.1",
    "firebase": "^11.4.0",
    "framer-motion": "^12.23.26",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "next": "^16.1.1",
    "next-intl": "^4.6.1",
    "postcss": "^8.5.6",
    "posthog-js": "^1.310.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "react-infinite-scroll-component": "^6.1.1",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "recharts": "^2.15.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.56.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/compat": "^1.2.6",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.8.0",
    "@expo/cli": "0.24.23",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/expo": "22.3.3",
    "@nx/jest": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/next": "22.3.3",
    "@nx/react": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@opennextjs/cloudflare": "^1.9.1",
    "@ronas-it/nx-generators": "^0.19.3",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.16",
    "@types/luxon": "^3.4.2",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "babel-jest": "30.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.5",
    "jest": "30.0.5",
    "jest-environment-jsdom": "30.0.5",
    "jest-util": "30.0.5",
    "nx": "22.3.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.2",
    "sass": "1.97.1",
    "syncpack": "^12.4.0",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.1",
    "tsc-files": "^1.1.4",
    "tslib": "^2.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "optionalDependencies": {
    "@ast-grep/napi-darwin-arm64": "0.34.4",
    "@ast-grep/napi-darwin-x64": "0.34.4",
    "@ast-grep/napi-linux-arm64-gnu": "0.34.4",
    "@ast-grep/napi-linux-arm64-musl": "0.34.4",
    "@ast-grep/napi-linux-x64-gnu": "0.34.4",
    "@ast-grep/napi-linux-x64-musl": "0.34.4",
    "@ast-grep/napi-win32-arm64-msvc": "0.34.4",
    "@ast-grep/napi-win32-ia32-msvc": "0.34.4",
    "@ast-grep/napi-win32-x64-msvc": "0.34.4"
  },
  "workspaces": [
    "apps/*"
  ],
  "lint-staged": {
    "*.{ts,tsx}": "tsc-files --noEmit types.d.ts",
    "*.{ts,tsx,js,html,json,md}": "prettier --write",
    "*.{ts,tsx,js}": "eslint --cache --fix"
  }
}
